# Copie para backend/.env e preencha. O .env nunca vai para o git.

# Chave que assina os tokens de login (mínimo 32 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Validade do login do caixa/admin, em minutos (480 = 8h, um turno).
JWT_EXPIRE_MINUTES=480

# Origens do front autorizadas a chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Banco de dados (padrão: SQLite local).
# DATABASE_URL=postgresql://usuario:senha@host:5432/mana

# Ambiente: dev ou prod. Em prod, o envio de código pelo terminal é bloqueado.
APP_ENV=dev

# Validade do login do cliente no app, em dias.
JWT_CLIENTE_EXPIRE_DIAS=30

# Código de acesso do cliente (OTP)
# console  = o código aparece no terminal da API (só desenvolvimento)
# whatsapp = envia pela WhatsApp Cloud API (exige conta comercial verificada na Meta)
OTP_PROVIDER=console
OTP_EXPIRE_MINUTES=10
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=

# Endereço público do app do cliente: o QR impresso nos cupons aponta para cá.
APP_PUBLIC_URL=http://localhost:5500

# SÓ DESENVOLVIMENTO: o app mostra o código de login do cliente na tela (para testar
# sem ler o terminal). A API não sobe com isso ligado fora de APP_ENV=dev/OTP_PROVIDER=console.
OTP_MOSTRAR_NO_APP=0
