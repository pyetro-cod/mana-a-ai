# Copie para backend/.env e preencha. O .env nunca vai para o git.

# Chave que assina os tokens de login (mínimo 32 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Validade do login do caixa/admin, em minutos (480 = 8h, um turno).
JWT_EXPIRE_MINUTES=480

# Origens do front autorizadas a chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Banco de dados (padrão: SQLite local).
# DATABASE_URL=postgresql://usuario:senha@host:5432/mana
